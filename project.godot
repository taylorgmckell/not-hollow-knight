; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="not-hollow-knight"
run/main_scene="res://src/world/graybox/graybox.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputSetup="*res://src/autoload/input_setup.gd"
GameState="*res://src/autoload/game_state.gd"
PreviewArt="*res://src/preview/preview_art.gd"
HitStop="*res://src/autoload/hit_stop.gd"
Sfx="*res://src/autoload/sfx.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="player_hitbox"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hitbox"
2d_physics/layer_6="enemy_hurtbox"
2d_physics/layer_7="hazard"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.11, 1)
